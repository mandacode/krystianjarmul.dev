# Contact form (Resend). With an empty key the /api/contact route stays functional
# but only logs the message instead of sending it, so the form flow still works locally.
RESEND_API_KEY=

# Sender must use a domain VERIFIED in Resend (SPF/DKIM DNS records added).
# onboarding@resend.dev only delivers to your own Resend account address.
CONTACT_FROM="Kontakt <no-reply@cannabase.pl>"

# Where contact form messages land. The visitor's address goes into reply-to.
CONTACT_TO=hi@krystianjarmul.dev
